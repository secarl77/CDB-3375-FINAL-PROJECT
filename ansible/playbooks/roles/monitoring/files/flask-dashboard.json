{
  "dashboard": {
    "id": null,
    "uid": null,
    "title": "Flask Application Metrics",
    "tags": ["flask", "prometheus"],
    "timezone": "browser",
    "schemaVersion": 30,
    "version": 1,
    "refresh": "5s",
    "panels": [
      {
        "type": "graph",
        "title": "Request Duration (avg)",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "rate(flask_http_request_duration_seconds_sum[1m]) / rate(flask_http_request_duration_seconds_count[1m])",
            "legendFormat": "{{handler}}",
            "interval": ""
          }
        ],
        "id": 1
      },
      {
        "type": "graph",
        "title": "Request Total (by method)",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "rate(flask_http_request_total[1m])",
            "legendFormat": "{{method}} - {{handler}} - {{status}}",
            "interval": ""
          }
        ],
        "id": 2
      },
      {
        "type": "graph",
        "title": "Exception Rate",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "rate(flask_http_request_exceptions_total[1m])",
            "legendFormat": "{{exception}} - {{handler}}",
            "interval": ""
          }
        ],
        "id": 3
      }
    ]
  },
  "overwrite": true
}

